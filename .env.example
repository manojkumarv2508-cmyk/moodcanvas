# ==============================================================================
# MoodCanvas - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' before running any backend or API-connected scripts.
# NEVER commit your actual '.env' file containing real secrets to version control.
# ==============================================================================

# Local Development Server Port
PORT=3000

# Optional: Cloud Storage or Hosting Integration
# CLOUD_STORAGE_BUCKET=
# CLOUD_STORAGE_REGION=
# CLOUD_API_KEY=

# Optional: AI / Generation Service APIs (e.g., if connecting direct text-to-image endpoints)
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# STABILITY_API_KEY=your_stability_api_key_here
